# =============================================================================
#  Variables de entorno de EmpatIA Digital
# =============================================================================
#
#  Cómo usar este archivo:
#    1. Cópialo con el nombre .env.local (ese archivo nunca se sube a GitHub).
#    2. Completa los valores que necesites.
#    3. Reinicia `npm run dev`.
#
#  Las sesiones funcionan sin nada de esto. Solo hace falta para el Oráculo
#  y la galería.
#
#  En Vercel, las mismas variables van en Settings → Environment Variables.
#  Después de cambiar una, hay que volver a publicar el sitio (Redeploy).
#
# =============================================================================


# -----------------------------------------------------------------------------
#  ORÁCULO  ·  chat con IA
# -----------------------------------------------------------------------------

# Enciende o apaga el Oráculo.
#   true  → se ven el botón, la página /oraculo y su API.
#   false → todo queda oculto.
# Antes de encenderlo en un servidor público, revisa la lista
# "Cómo lanzarlo" en docs/oraculo.md.
# Se lee al compilar: si la cambias, reinicia el servidor o vuelve a publicar.
ORACULO_ACTIVO=true

# Clave de la API de OpenAI. Obligatoria si el Oráculo está encendido.
# Se crea en https://platform.openai.com/api-keys y empieza por "sk-".
OPENAI_API_KEY=

# Firma las sesiones del chat para que nadie las altere. Obligatoria si el
# Oráculo está encendido. Mínimo 32 caracteres al azar. Para crear uno:
#   openssl rand -base64 48
# Si la cambias, se cierran las conversaciones abiertas.
ORACULO_SECRET=

# Opcional. Modelos de IA. Si no se ponen, se usan estos.
# Antes de cambiar el de riesgo, corre `npm run eval:riesgo`.
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_RISK_MODEL=gpt-5.4-mini


# -----------------------------------------------------------------------------
#  GALERÍA  ·  subida de imágenes a Google Drive
# -----------------------------------------------------------------------------
#  Sin estas dos variables, la página /subir avisa que la subida no está abierta.
#  Los pasos para crear el script están en docs/galeria.md.

# Dirección del script de Google. Termina en /exec.
GALERIA_SCRIPT_URL=

# Clave compartida con el script. Mínimo 32 caracteres al azar:
#   openssl rand -base64 48
GALERIA_SECRET=

# Ojo: SECRET y FOLDER_ID NO van en este archivo ni en Vercel.
# Se guardan dentro del script de Google
# (Configuración del proyecto → Propiedades del script):
#   SECRET     → el mismo valor de GALERIA_SECRET.
#   FOLDER_ID  → el código de la carpeta "Galería EmpatIA" en Drive
#                (la última parte de la dirección de la carpeta).
#
# Solo como referencia: estos dos se ponen en el script de Google, no aquí.
# SECRET=
# FOLDER_ID=

# -----------------------------------------------------------------------------
#  SITIO
# -----------------------------------------------------------------------------

# Opcional. Dirección pública que usan los códigos QR.
# Si no se pone: https://www.empatia-digital.com
# (y http://localhost:3000 con `npm run dev`).
# SITE_URL=


# -----------------------------------------------------------------------------
#  SOLO PARA PRUEBAS EN TU COMPUTADOR  ·  en Vercel no tienen efecto
# -----------------------------------------------------------------------------

# Usa una IA falsa, sin conectarse a OpenAI ni gastar saldo.
# ORACULO_IA_SIMULADA=1

# Acepta las imágenes de la galería sin guardarlas en Drive.
# GALERIA_SIMULADA=1
